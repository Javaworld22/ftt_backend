<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>100 SQL Practice Questions - Study Mode</title>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Space Grotesk', sans-serif; background: #0f0f13; color: #e2e0f0; min-height: 100vh; padding: 0 0 60px; }

        header {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            padding: 48px 40px 40px;
            border-bottom: 1px solid #2a2a4a;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-inner { max-width: 1100px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
        h1 { font-size: 28px; font-weight: 700; letter-spacing: -0.5px; color: #fff; }
        h1 span { color: #7c6eff; }
        .subtitle { font-size: 13px; color: #8888aa; margin-top: 4px; }

        .stats { display: flex; gap: 12px; flex-wrap: wrap; }
        .stat { background: rgba(124,110,255,0.12); border: 1px solid rgba(124,110,255,0.25); border-radius: 8px; padding: 6px 14px; font-size: 12px; font-weight: 600; color: #a89fff; white-space: nowrap; }

        .controls { max-width: 1100px; margin: 24px auto 0; padding: 0 40px; display: flex; gap: 8px; flex-wrap: wrap; }
        .filter-btn { padding: 7px 16px; border-radius: 20px; font-size: 12px; font-weight: 600; cursor: pointer; border: 1px solid #2a2a4a; background: #1a1a2e; color: #8888aa; transition: all .2s; font-family: inherit; }
        .filter-btn.active, .filter-btn:hover { background: #7c6eff; color: #fff; border-color: #7c6eff; }

        main { max-width: 1100px; margin: 0 auto; padding: 32px 40px 0; display: grid; gap: 16px; }

        .q-card { background: #16161f; border: 1px solid #2a2a4a; border-radius: 14px; overflow: hidden; transition: border-color .2s; }
        .q-card:hover { border-color: #4a4a7a; }

        .q-header { display: flex; align-items: flex-start; gap: 14px; padding: 18px 20px; }
        .q-num { background: #7c6eff; color: #fff; font-size: 11px; font-weight: 700; min-width: 28px; height: 28px; border-radius: 6px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .q-text { font-size: 14px; font-weight: 500; color: #e2e0f0; line-height: 1.5; flex: 1; }

        .q-meta { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin-top: 8px; }
        .tag { font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 10px; text-transform: uppercase; letter-spacing: .04em; }

        .tag-where { background: #1a3a2a; color: #4ade80; }
        .tag-select { background: #1a2a3a; color: #60a5fa; }
        .tag-agg { background: #2a1a3a; color: #c084fc; }
        .tag-join { background: #3a2a1a; color: #fb923c; }
        .tag-cte { background: #2a1a1a; color: #f87171; }
        .tag-union { background: #1a2a2a; color: #34d399; }
        .tag-distinct { background: #2a2a1a; color: #facc15; }
        .tag-subquery { background: #1a1a2a; color: #818cf8; }

        @media(max-width: 640px) { header { padding: 28px 20px 24px; } .controls { padding: 0 20px; } main { padding: 20px 20px 0; } }
    </style>
</head>
<body>

<header>
    <div class="header-inner">
        <div>
            <h1>SQL <span>Practice</span> Hub</h1>
            <div class="subtitle">Self-Assessment Study Guide · 16-Table Dataset</div>
        </div>
        <div class="stats">
            <div class="stat">100 Questions</div>
            <div class="stat">Study Mode: Answers Disabled</div>
        </div>
    </div>
</header>

<div class="controls">
    <button class="filter-btn active" onclick="filterAll()">All Questions</button>
    <button class="filter-btn" onclick="filterTag('where')">WHERE</button>
    <button class="filter-btn" onclick="filterTag('agg')">Aggregates</button>
    <button class="filter-btn" onclick="filterTag('join')">JOINs</button>
    <button class="filter-btn" onclick="filterTag('cte')">CTE</button>
    <button class="filter-btn" onclick="filterTag('subquery')">Subquery</button>
</div>

<main id="questions"></main>

<script>
const Q = [
    {n:1, t:"List all employees in the Sales department.", tags:["where","select"]},
    {n:2, t:"Find all customers from New York.", tags:["where","select"]},
    {n:3, t:"Show all products with a price greater than 50.", tags:["where","select"]},
    {n:4, t:"Find all active job postings.", tags:["where","select"]},
    {n:5, t:"Get all orders with status 'Shipped'.", tags:["where","select"]},
    {n:6, t:"Find employees with a salary between 70,000 and 100,000.", tags:["where","select"]},
    {n:7, t:"List candidates with more than 4 years of experience.", tags:["where","select"]},
    {n:8, t:"Show stores that are currently active.", tags:["where","select"]},
    {n:9, t:"Find applications with status 'Interview'.", tags:["where","select"]},
    {n:10, t:"Get all full-time employees hired after 2020-01-01.", tags:["where","select"]},
    {n:11, t:"List all unique departments in the employee2 table.", tags:["distinct"]},
    {n:12, t:"Show all unique cities customers are from.", tags:["distinct"]},
    {n:13, t:"Get all unique job types in the jobs table.", tags:["distinct"]},
    {n:14, t:"List all unique product categories.", tags:["distinct"]},
    {n:15, t:"Find all unique statuses in the applications table.", tags:["distinct"]},
    {n:16, t:"Count the total number of employees.", tags:["agg"]},
    {n:17, t:"Count the number of applications per job.", tags:["agg"]},
    {n:18, t:"Count customers per state.", tags:["agg"]},
    {n:19, t:"How many products are in each category?", tags:["agg"]},
    {n:20, t:"Count orders per status.", tags:["agg"]},
    {n:21, t:"Find the highest salary in the employee2 table.", tags:["agg"]},
    {n:22, t:"Find the lowest salary in the employee2 table.", tags:["agg"]},
    {n:23, t:"What is the most expensive product?", tags:["agg"]},
    {n:24, t:"Find the earliest hire date in full_time_employees.", tags:["agg"]},
    {n:25, t:"Find the minimum and maximum job salary ranges.", tags:["agg"]},
    {n:26, t:"Find the max budget across all departments.", tags:["agg"]},
    {n:27, t:"Which customer has the highest total_spent?", tags:["agg"]},
    {n:28, t:"What is the average salary by department in employee2?", tags:["agg"]},
    {n:29, t:"What is the average price per product category?", tags:["agg"]},
    {n:30, t:"What is the average hourly rate of part-time employees?", tags:["agg"]},
    {n:31, t:"Average total_spent per city for customers.", tags:["agg"]},
    {n:32, t:"Average sales and advertising spend per region.", tags:["agg"]},
    {n:33, t:"Display employee full name as a single alias 'full_name'.", tags:["select"]},
    {n:34, t:"Show job title and company_id using descriptive aliases.", tags:["select"]},
    {n:35, t:"Alias the stores table as 's' and select store_name and city.", tags:["select"]},
    {n:36, t:"Join jobs and applications to see application counts per job title.", tags:["join"]},
    {n:37, t:"Join applications and candidates to see who applied for each job.", tags:["join"]},
    {n:38, t:"Join orders with products to show product name per order.", tags:["join"]},
    {n:39, t:"Join order_items with stores to see sales by store.", tags:["join"]},
    {n:40, t:"Join employees with departments to show each employee's department name.", tags:["join"]},
    {n:41, t:"Join jobs and companies to show job title with company name.", tags:["join"]},
    {n:42, t:"Show all jobs and their applications (including jobs with no applications).", tags:["join"]},
    {n:43, t:"Show all candidates even if they haven't applied.", tags:["join"]},
    {n:44, t:"Show all products and their order_items (including products never ordered).", tags:["join"]},
    {n:45, t:"Show all departments even if no employees are assigned.", tags:["join"]},
    {n:46, t:"Show all applications and match with job info using RIGHT JOIN.", tags:["join"]},
    {n:47, t:"Show all order_items and their products using RIGHT JOIN.", tags:["join"]},
    {n:48, t:"Show all employees and departments using a simulated FULL OUTER JOIN.", tags:["join","union"]},
    {n:49, t:"Find pairs of employees in the same department using a SELF JOIN.", tags:["join"]},
    {n:50, t:"Generate all combinations of products and stores using a CROSS JOIN.", tags:["join"]},
    {n:51, t:"Join jobs, applications, and candidates for full application details.", tags:["join"]},
    {n:52, t:"Join order_items, products, and stores to see item details per store.", tags:["join"]},
    {n:53, t:"Join employees, departments, and jobs to see employee roles and locations.", tags:["join"]},
    {n:54, t:"Count total candidates who applied for 'Engineer' roles.", tags:["join","agg"]},
    {n:55, t:"Find the total revenue generated by each product category.", tags:["join","agg"]},
    {n:56, t:"List all unique cities where both a store and a customer exist.", tags:["join","distinct"]},
    {n:57, t:"Find employees who earn more than the average salary.", tags:["subquery"]},
    {n:58, t:"Find products that have never been ordered.", tags:["subquery"]},
    {n:59, t:"Use a CTE to find the top 3 highest-spending customers.", tags:["cte"]},
    {n:60, t:"Calculate the running total of sales using a window function.", tags:["agg"]},
    {n:61, t:"Find departments where the total salary expense exceeds $500,000.", tags:["agg","where"]},
    {n:62, t:"Identify the most common job type in the database.", tags:["agg"]},
    {n:63, t:"List employees whose last name starts with 'S'.", tags:["where"]},
    {n:64, t:"Find all orders placed in the last 30 days.", tags:["where","date"]},
    {n:65, t:"Find the difference between the min and max salary in each department.", tags:["agg"]},
    {n:66, t:"List all products with 'Pro' in their name.", tags:["where"]},
    {n:67, t:"Combine lists of candidate names and employee names.", tags:["union"]},
    {n:68, t:"Find the job with the highest number of rejected applications.", tags:["join","agg"]},
    {n:69, t:"Calculate the average tenure of employees in years.", tags:["agg","date"]},
    {n:70, t:"Show the top 5 most expensive products and their stock levels.", tags:["select","agg"]},
    {n:71, t:"Find customers who have placed more than 5 orders.", tags:["agg"]},
    {n:72, t:"Calculate the total discount given on all orders.", tags:["agg"]},
    {n:73, t:"Identify stores located in California or Texas.", tags:["where"]},
    {n:74, t:"Find applications submitted on weekends.", tags:["where","date"]},
    {n:75, t:"Rank employees within each department by salary.", tags:["agg"]},
    {n:76, t:"Find the second highest salary in the company.", tags:["subquery"]},
    {n:77, t:"Calculate the percentage of total sales contributed by each store.", tags:["cte","agg"]},
    {n:78, t:"Find candidates who have 'SQL' listed as a skill.", tags:["where"]},
    {n:79, t:"List all departments located in 'London'.", tags:["where"]},
    {n:80, t:"Find orders where the quantity is greater than the average quantity.", tags:["subquery"]},
    {n:81, t:"Get the month-over-month growth in sales.", tags:["cte","date"]},
    {n:82, t:"Find employees who are also listed as candidates.", tags:["join"]},
    {n:83, t:"Use CASE to label products as 'Cheap', 'Mid', or 'Expensive'.", tags:["select"]},
    {n:84, t:"Find the store with the lowest total sales revenue.", tags:["join","agg"]},
    {n:85, t:"Find the average price of products in 'Electronics'.", tags:["where","agg"]},
    {n:86, t:"Find all job applications for 'Remote' positions.", tags:["join","where"]},
    {n:87, t:"Find the number of employees hired each year.", tags:["agg","date"]},
    {n:88, t:"List customers who haven't placed an order in 2024.", tags:["subquery","date"]},
    {n:89, t:"Find the total weight of all products in an order.", tags:["join","agg"]},
    {n:90, t:"Calculate the average time from application to interview.", tags:["agg","date"]},
    {n:91, t:"Find the most popular product in each state.", tags:["cte","agg"]},
    {n:92, t:"Identify the manager with the most direct reports.", tags:["join","agg"]},
    {n:93, t:"List products that are currently out of stock.", tags:["where"]},
    {n:94, t:"Find the total number of unique customers per month.", tags:["agg","date"]},
    {n:95, t:"Calculate the tax (15%) for each order total.", tags:["select"]},
    {n:96, t:"Find candidates who applied for multiple jobs.", tags:["agg"]},
    {n:97, t:"List all stores that have more than 10 employees.", tags:["join","agg"]},
    {n:98, t:"Find the total number of orders per customer.", tags:["agg"]},
    {n:99, t:"Find the job posting with the shortest description.", tags:["agg"]},
    {n:100, t:"List the top 3 departments with the most diverse job types.", tags:["agg","distinct"]}
];

const tagLabels = {
    where: 'tag-where', select: 'tag-select', agg: 'tag-agg', join: 'tag-join',
    cte: 'tag-cte', union: 'tag-union', distinct: 'tag-distinct',
    subquery: 'tag-subquery', date: 'tag-date'
};

const tagNames = {
    where: 'WHERE', select: 'SELECT', agg: 'Aggregate', join: 'JOIN',
    cte: 'CTE', union: 'UNION', distinct: 'DISTINCT',
    subquery: 'Subquery', date: 'Date'
};

function renderQuestions(data) {
    const container = document.getElementById('questions');
    container.innerHTML = data.map(q => `
        <div class="q-card" data-tags="${q.tags.join(',')}">
            <div class="q-header">
                <div class="q-num">${q.n}</div>
                <div class="q-text">
                    ${q.t}
                    <div class="q-meta">
                        ${q.tags.map(t => `<span class="tag ${tagLabels[t]}">${tagNames[t]}</span>`).join('')}
                    </div>
                </div>
            </div>
        </div>
    `).join('');
}

function filterTag(tag) {
    document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
    event.target.classList.add('active');

    document.querySelectorAll('.q-card').forEach(card => {
        card.style.display = card.dataset.tags.includes(tag) ? 'block' : 'none';
    });
}

function filterAll() {
    document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
    event.target.classList.add('active');
    document.querySelectorAll('.q-card').forEach(card => card.style.display = 'block');
}

// Initial Load
renderQuestions(Q);
</script>

</body>
</html>